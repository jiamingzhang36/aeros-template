#!/usr/bin/env python3
"""AEROS protected-path pre-commit guard.

AEROS-PROTECTED-PATH-HOOK-001

This hook refuses to commit protected authority paths unless the human operator
sets AEROS_ALLOW_PROTECTED_COMMIT=1 for that commit. It is intentionally narrow:
it does not decide whether the protected edit is scientifically valid.
"""

from __future__ import annotations

import os
import subprocess
import sys


PROTECTED_EXACT = {
    "docs/protected_definitions.yml",
    "docs/data_contract.yml",
    "evidence/claim_registry.md",
    "decisions/decision_log.csv",
    "harness/permissions.yml",
}

PROTECTED_PREFIXES = (
    "data/raw/",
    "decisions/approvals/",
)


def git(args: list[str]) -> str:
    return subprocess.check_output(["git", *args], text=True, stderr=subprocess.DEVNULL)


def is_protected(path: str) -> bool:
    return path in PROTECTED_EXACT or any(path.startswith(prefix) for prefix in PROTECTED_PREFIXES)


def main() -> int:
    try:
        staged = [line.strip() for line in git(["diff", "--cached", "--name-only"]).splitlines()]
    except Exception as exc:
        print(f"AEROS protected-path hook could not inspect staged files: {exc}", file=sys.stderr)
        return 1
    hits = [path for path in staged if path and is_protected(path)]
    if not hits:
        return 0
    if os.environ.get("AEROS_ALLOW_PROTECTED_COMMIT") == "1":
        print(
            "AEROS protected-path hook: human override accepted for protected paths:",
            file=sys.stderr,
        )
        for path in hits:
            print(f"  - {path}", file=sys.stderr)
        return 0
    print("AEROS protected-path hook blocked protected staged file(s):", file=sys.stderr)
    for path in hits:
        print(f"  - {path}", file=sys.stderr)
    print(
        "Set AEROS_ALLOW_PROTECTED_COMMIT=1 only after explicit human approval/gate review.",
        file=sys.stderr,
    )
    print(
        "This hook enforces commit boundaries; it does not certify scientific validity.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())

