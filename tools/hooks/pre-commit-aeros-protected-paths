#!/usr/bin/env python3
"""AEROS protected-path pre-commit guard.

AEROS-PROTECTED-PATH-HOOK-001

This hook requires two different forms of evidence:
1. protected authority paths still need an explicit human override;
2. significant research-facing paths need a staged context effect report that
   actually observed the changed path.

Neither condition certifies scientific validity or human identity.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys


PROTECTED_EXACT = {
    "docs/protected_definitions.yml",
    "docs/data_contract.yml",
    "evidence/claim_registry.md",
    "decisions/decision_log.csv",
    "harness/permissions.yml",
}

PROTECTED_PREFIXES = (
    "data/raw/",
    "decisions/approvals/",
    "campaigns/campaign_decisions.yml",
)

CONTEXT_EXACT = {"evidence/claim_registry.md"}
CONTEXT_PREFIXES = ("paper/", "tex/", "data/processed/", "evidence/", "code/")
EFFECT_PREFIX = "outputs/context/episodes/"
EFFECT_SUFFIX = "/effect_report.json"
ACCEPTED_EFFECT_STATUSES = {
    "BLOCKED_BEFORE_EXECUTION",
    "REUSE_OR_REVALIDATION_PROMPTED",
    "RISK_RAISED",
    "GUIDANCE_RECORDED",
    "RESPONSE_ARTIFACT_OBSERVED",
}


def git(args: list[str]) -> str:
    return subprocess.check_output(["git", *args], text=True, stderr=subprocess.DEVNULL)


def is_protected(path: str) -> bool:
    return path in PROTECTED_EXACT or any(path.startswith(prefix) for prefix in PROTECTED_PREFIXES)


def requires_context_evidence(path: str) -> bool:
    return path in CONTEXT_EXACT or any(path.startswith(prefix) for prefix in CONTEXT_PREFIXES)


def staged_json(path: str) -> dict:
    raw = git(["show", f":{path}"])
    parsed = json.loads(raw)
    return parsed if isinstance(parsed, dict) else {}


def observed_paths(effect: dict) -> set[str]:
    delta = effect.get("observed_workspace_delta")
    if not isinstance(delta, dict):
        return set()
    records = delta.get("paths")
    if not isinstance(records, list):
        return set()
    return {
        str(record.get("path") or "")
        for record in records
        if isinstance(record, dict) and str(record.get("path") or "")
    }


def context_coverage(staged: list[str]) -> tuple[set[str], list[str]]:
    reports = [
        path for path in staged
        if path.startswith(EFFECT_PREFIX) and path.endswith(EFFECT_SUFFIX)
    ]
    covered: set[str] = set()
    invalid: list[str] = []
    for path in reports:
        try:
            effect = staged_json(path)
        except Exception as exc:
            invalid.append(f"{path}: unreadable staged JSON ({exc})")
            continue
        if not effect.get("preflight_recorded"):
            invalid.append(f"{path}: no durable preflight was recorded")
            continue
        if str(effect.get("status") or "") not in ACCEPTED_EFFECT_STATUSES:
            invalid.append(f"{path}: unsupported effect status {effect.get('status')!r}")
            continue
        covered.update(observed_paths(effect))
    return covered, invalid


def main() -> int:
    try:
        staged = [line.strip() for line in git(["diff", "--cached", "--name-only"]).splitlines()]
    except Exception as exc:
        print(f"AEROS protected-path hook could not inspect staged files: {exc}", file=sys.stderr)
        return 1
    hits = [path for path in staged if path and is_protected(path)]
    if hits and os.environ.get("AEROS_ALLOW_PROTECTED_COMMIT") != "1":
        print("AEROS protected-path hook blocked protected staged file(s):", file=sys.stderr)
        for path in hits:
            print(f"  - {path}", file=sys.stderr)
        print("Set AEROS_ALLOW_PROTECTED_COMMIT=1 only after explicit human approval/gate review.", file=sys.stderr)
        return 1

    context_hits = [path for path in staged if path and requires_context_evidence(path)]
    if context_hits:
        covered, invalid_reports = context_coverage(staged)
        missing = [path for path in context_hits if path not in covered]
        if missing or invalid_reports:
            print("AEROS context-effect hook blocked significant staged file(s):", file=sys.stderr)
            for path in missing:
                print(f"  - missing observed effect coverage: {path}", file=sys.stderr)
            for message in invalid_reports:
                print(f"  - invalid effect report: {message}", file=sys.stderr)
            print(
                "Run a scoped preflight, close its context episode, and stage the matching outputs/context/episodes/.../effect_report.json.",
                file=sys.stderr,
            )
            print(
                "This verifies an observed AEROS lifecycle, not scientific validity or a human approval.",
                file=sys.stderr,
            )
            return 1
    if hits:
        print("AEROS protected-path hook: human override plus context-effect evidence accepted.", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
